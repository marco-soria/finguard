<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!-- Resolved on 2026-11-13 with scripts/Get-LatestNuGetVersion.ps1. Stable versions only. -->
    <AspireVersion>13.6.5</AspireVersion>
    <WolverineVersion>6.64.0</WolverineVersion>
    <!-- Latest stable 10.x; the 11.x line targets .NET 11 and is out of scope for net10.0. -->
    <MicrosoftNet10Version>10.0.15</MicrosoftNet10Version>
  </PropertyGroup>
  <ItemGroup Label="Aspire">
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Npgsql" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="$(AspireVersion)" />
  </ItemGroup>
  <ItemGroup Label="Messaging">
    <PackageVersion Include="WolverineFx" Version="$(WolverineVersion)" />
    <PackageVersion Include="WolverineFx.Postgresql" Version="$(WolverineVersion)" />
    <PackageVersion Include="WolverineFx.EntityFrameworkCore" Version="$(WolverineVersion)" />
  </ItemGroup>
  <ItemGroup Label="Data">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(MicrosoftNet10Version)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(MicrosoftNet10Version)" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Read-side queries (ADR-0007). -->
    <PackageVersion Include="Dapper" Version="2.1.89" />
  </ItemGroup>
  <ItemGroup Label="Auth and config">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="$(MicrosoftNet10Version)" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.2" />
  </ItemGroup>
  <ItemGroup Label="Observability">
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
  </ItemGroup>
  <ItemGroup Label="AI">
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.28.0" />
    <!-- 10.11.0 matches Microsoft.Agents.AI 1.28.0; 11.0.0 pulls .NET 11 Microsoft.Extensions.* abstractions into net10.0. -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.11.0" />
  </ItemGroup>
</Project>
