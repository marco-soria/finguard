<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!-- Resolved on 2026-11-14 with scripts/Get-LatestNuGetVersion.ps1. Stable versions only. -->
    <AspireVersion>13.6.5</AspireVersion>
    <WolverineVersion>6.64.2</WolverineVersion>
    <!-- Latest stable 10.x; the 11.x line targets .NET 11 and is out of scope for net10.0. -->
    <MicrosoftNet10Version>10.0.15</MicrosoftNet10Version>
  </PropertyGroup>
  <ItemGroup Label="Aspire">
    <!-- Aspire.Hosting.AppHost is referenced implicitly by Aspire.AppHost.Sdk (version in the AppHost csproj Sdk
         attribute); a PackageVersion for it fails restore with NU1009. -->
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Npgsql" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="$(AspireVersion)" />
  </ItemGroup>
  <ItemGroup Label="Messaging">
    <PackageVersion Include="WolverineFx" Version="$(WolverineVersion)" />
    <PackageVersion Include="WolverineFx.Postgresql" Version="$(WolverineVersion)" />
    <PackageVersion Include="WolverineFx.EntityFrameworkCore" Version="$(WolverineVersion)" />
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="$(WolverineVersion)" />
  </ItemGroup>
  <ItemGroup Label="Data">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(MicrosoftNet10Version)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(MicrosoftNet10Version)" />
    <!-- Transitive pin: Npgsql EF 10.0.3 and EF 10.0.15 otherwise resolve Relational 10.0.14 and 10.0.15 (MSB3277). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(MicrosoftNet10Version)" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.4" />
    <!-- Read-side queries (ADR-0007). -->
    <PackageVersion Include="Dapper" Version="2.1.100" />
    <!-- Community package (R-10); snake_case naming (D-32). -->
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
  </ItemGroup>
  <ItemGroup Label="Parsing">
    <!-- RFC 4180 field reader only; FinGuard validates every field itself (D-113). -->
    <PackageVersion Include="CsvHelper" Version="34.1.0" />
  </ItemGroup>
  <ItemGroup Label="Service defaults">
    <!-- 10.x line (template uses 10.10.0); 11.x pulls .NET 11 abstractions into net10.0. -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.1" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.1" />
  </ItemGroup>
  <ItemGroup Label="Auth and config">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="$(MicrosoftNet10Version)" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.2" />
  </ItemGroup>
  <ItemGroup Label="Observability">
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
  </ItemGroup>
  <ItemGroup Label="AI">
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.28.0" />
    <!-- 10.11.0 matches Microsoft.Agents.AI 1.28.0; 11.0.0 pulls .NET 11 Microsoft.Extensions.* abstractions into net10.0. -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.11.0" />
  </ItemGroup>
  <ItemGroup Label="Analyzers">
    <!-- Stable 5.x requires Roslyn 5.6+; SDK 10.0.403 ships Roslyn 5.9. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(MicrosoftNet10Version)" />
    <!-- 10.x line, matching Microsoft.Extensions.Http.Resilience; 11.x targets .NET 11. -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.11.1" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.1" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageVersion Include="TngTech.ArchUnitNET" Version="0.13.5" />
  </ItemGroup>
</Project>
