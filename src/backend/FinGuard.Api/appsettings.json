{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Npgsql.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ForwardedHeaders": {
    "Enabled": true
  },
  "RateLimiting": {
    "ReadsPerMinute": 120,
    "AnonymousPerMinute": 20,
    "UploadsPerMinute": 10
  }
}
